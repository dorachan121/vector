# エディタ間で書式を揃える（Visual Studio / Rider / VS Code）。改行コードは .gitattributes に任せる
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,asmdef,json,yml,yaml,md}]
indent_style = space

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
# 不要なコードを残さない（Tools の dotnet build と CI で検査する。Unity のコンパイラはこれらを実行しない）
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

[*.{asmdef,json}]
indent_size = 4

[*.{csproj,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Unity が生成するファイルは触らない
[*.{unity,prefab,asset,meta,mat}]
insert_final_newline = unset
trim_trailing_whitespace = unset
